{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-ar-editor/schemas/config.schema.json",
  "title": "config",
  "description": "export 결과물 런타임 config. project.webar.json 의 부분집합으로, 런타임이 장면을 복원하는 데 필요한 최소 정보를 담는다.",
  "type": "object",
  "required": ["schemaVersion", "tracking", "scene"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "스키마 버전 (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["0.1.0"]
    },
    "tracking": {
      "description": "AR 트래킹 설정",
      "oneOf": [
        {
          "$ref": "#/definitions/trackingImage"
        },
        {
          "$ref": "#/definitions/trackingFace"
        },
        {
          "$ref": "#/definitions/trackingMarker"
        },
        {
          "$ref": "#/definitions/trackingGPS"
        }
      ]
    },
    "scene": {
      "type": "object",
      "description": "런타임 장면 구성",
      "required": ["background", "units", "objects"],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "enum": ["camera", "transparent", "color"]
        },
        "backgroundColor": {
          "type": "string"
        },
        "units": {
          "type": "string",
          "enum": ["meters", "centimeters"]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/runtimeObject"
          }
        }
      }
    }
  },
  "definitions": {
    "trackingImage": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "image" },
        "target": { "type": "string" },
        "preview": { "type": "string" }
      }
    },
    "trackingFace": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "face" },
        "maxFaces": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 }
      }
    },
    "trackingMarker": {
      "type": "object",
      "required": ["type", "markerSrc"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "marker" },
        "markerSrc": { "type": "string" }
      }
    },
    "trackingGPS": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "gps" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radius": { "type": "number" }
      }
    },
    "runtimeObject": {
      "type": "object",
      "description": "런타임에서 장면을 구성하는 오브젝트",
      "required": ["id", "type", "src", "position", "rotation", "scale", "visible"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "type": {
          "type": "string",
          "enum": ["model", "image", "video", "audio", "text", "button"]
        },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "visible": { "type": "boolean" },
        "anchorType": {
          "type": "string",
          "enum": ["target", "forehead", "leftEye", "rightEye", "mouth", "world"]
        },
        "animationName": { "type": "string" },
        "autoplay": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "content": { "type": "string" },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "color": { "type": "string" },
            "emissiveIntensity": { "type": "number", "minimum": 0 },
            "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
            "metalness": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "events": {
          "type": "array",
          "description": "인라인 단순 이벤트 (graph.webar.json 없이 config만으로 동작할 때)",
          "items": {
            "type": "object",
            "required": ["trigger", "action"],
            "additionalProperties": false,
            "properties": {
              "trigger": {
                "type": "string",
                "enum": ["tap", "targetFound", "targetLost", "videoEnded", "soundEnded"]
              },
              "action": {
                "type": "string",
                "enum": [
                  "show", "hide", "toggle",
                  "playSound", "pauseSound",
                  "playVideo", "pauseVideo",
                  "playAnimation",
                  "openURL"
                ]
              },
              "target": { "type": "string" },
              "src": { "type": "string" },
              "animation": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
