{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-ar-editor/schemas/bindings.webar.schema.json",
  "title": "bindings.webar",
  "description": "Signal Graph — 매 프레임 실시간 데이터 채널(source)을 오브젝트 속성(target)에 연결한다. MVP 4에서 도입. TouchDesigner CHOP Reference 개념 대응.",
  "type": "object",
  "required": ["schemaVersion", "bindings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "스키마 버전 (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["0.1.0"]
    },
    "bindings": {
      "type": "array",
      "description": "Signal Binding 목록",
      "items": {
        "$ref": "#/definitions/binding"
      }
    }
  },
  "definitions": {
    "signalSource": {
      "type": "string",
      "description": "실시간 데이터 채널 식별자 (dot-case namespace)",
      "enum": [
        "audio.volume",
        "audio.low",
        "audio.mid",
        "audio.high",
        "audio.peak",
        "audio.beat",
        "face.x",
        "face.y",
        "face.z",
        "face.pitch",
        "face.yaw",
        "face.roll",
        "face.mouthOpen",
        "face.leftEye",
        "face.rightEye",
        "face.foreheadAnchor",
        "time.seconds",
        "time.delta",
        "time.sin",
        "time.cos",
        "time.loop",
        "random.value",
        "random.noise",
        "random.pulse",
        "target.visible",
        "target.confidence",
        "target.x",
        "target.y",
        "target.rotation"
      ]
    },
    "signalSourceWithSpectrum": {
      "description": "audio.spectrum[n] 동적 채널을 포함한 signal source. 정적 enum 또는 audio.spectrum[숫자] 패턴.",
      "oneOf": [
        { "$ref": "#/definitions/signalSource" },
        {
          "type": "string",
          "pattern": "^audio\\.spectrum\\[\\d+\\]$",
          "description": "FFT 주파수 빈 채널 (예: audio.spectrum[0])"
        }
      ]
    },
    "mapConfig": {
      "type": "object",
      "description": "값 범위 변환 및 수식 설정",
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "array",
          "description": "입력 범위 [min, max]",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "out": {
          "type": "array",
          "description": "출력 범위 [min, max]",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "clamp": {
          "type": "boolean",
          "description": "출력 범위 밖으로 나가지 않도록 제한",
          "default": false
        },
        "smooth": {
          "type": "number",
          "description": "프레임 간 평활화 계수 (0 = 즉각 반응, 1 = 변화 없음)",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "invert": {
          "type": "boolean",
          "description": "출력 값 반전 (out[1]..out[0] 방향으로)",
          "default": false
        }
      }
    },
    "binding": {
      "type": "object",
      "description": "단일 Signal Binding. source 채널 값을 target 속성에 매 프레임 적용한다.",
      "required": ["id", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "바인딩 고유 ID (kebab-case)",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "source": {
          "$ref": "#/definitions/signalSourceWithSpectrum"
        },
        "target": {
          "type": "string",
          "description": "오브젝트 속성 경로 (dot-case). 패턴: objects.{objectId}.{property} 또는 objects.{objectId}.{group}.{property}",
          "pattern": "^objects\\.[a-z0-9][a-z0-9-]*[a-z0-9]\\..+$",
          "examples": [
            "objects.forehead-crown.scale",
            "objects.forehead-crown.position.x",
            "objects.forehead-crown.rotation.y",
            "objects.forehead-crown.material.opacity",
            "objects.forehead-crown.material.emissiveIntensity",
            "objects.forehead-crown.animation.speed",
            "objects.forehead-particles.particle.rate",
            "objects.overlay-video.video.playbackRate"
          ]
        },
        "map": {
          "$ref": "#/definitions/mapConfig"
        },
        "enabled": {
          "type": "boolean",
          "description": "바인딩 활성화 여부 (비활성화해도 JSON에 보존)",
          "default": true
        }
      }
    }
  }
}
