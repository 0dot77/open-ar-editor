{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-ar-editor/schemas/graph.webar.schema.json",
  "title": "graph.webar",
  "description": "Event Graph — 특정 사건이 발생했을 때 한 번 실행되는 1회성 이벤트 체인을 정의한다. 런타임은 이 JSON을 해석해 실행한다 (코드 생성 금지).",
  "type": "object",
  "required": ["schemaVersion", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "스키마 버전 (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["0.1.0"]
    },
    "nodes": {
      "type": "array",
      "description": "그래프를 구성하는 노드 목록. type 필드로 discriminated union.",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edges": {
      "type": "array",
      "description": "노드 간 실행 연결 (from → to). 순차 실행 기본.",
      "items": {
        "$ref": "#/definitions/edge"
      }
    }
  },
  "definitions": {
    "nodeBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "노드 고유 ID (kebab-case)",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "label": {
          "type": "string",
          "description": "에디터에서 표시하는 작가 친화적 이름"
        },
        "position": {
          "type": "object",
          "description": "에디터 캔버스 상의 노드 위치 (저장용)",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },
    "node": {
      "description": "입력 / 동작 / 데이터 노드 (type 기준 discriminated union)",
      "oneOf": [
        { "$ref": "#/definitions/nodeEventTargetFound" },
        { "$ref": "#/definitions/nodeEventTargetLost" },
        { "$ref": "#/definitions/nodeEventTap" },
        { "$ref": "#/definitions/nodeEventButtonClick" },
        { "$ref": "#/definitions/nodeEventTimeElapsed" },
        { "$ref": "#/definitions/nodeEventVideoEnded" },
        { "$ref": "#/definitions/nodeEventSoundEnded" },
        { "$ref": "#/definitions/nodeActionShow" },
        { "$ref": "#/definitions/nodeActionHide" },
        { "$ref": "#/definitions/nodeActionToggle" },
        { "$ref": "#/definitions/nodeActionPlaySound" },
        { "$ref": "#/definitions/nodeActionPauseSound" },
        { "$ref": "#/definitions/nodeActionPlayVideo" },
        { "$ref": "#/definitions/nodeActionPauseVideo" },
        { "$ref": "#/definitions/nodeActionPlayAnimation" },
        { "$ref": "#/definitions/nodeActionMoveTo" },
        { "$ref": "#/definitions/nodeActionSetScale" },
        { "$ref": "#/definitions/nodeActionSetColor" },
        { "$ref": "#/definitions/nodeActionOpenURL" },
        { "$ref": "#/definitions/nodeActionSceneChange" },
        { "$ref": "#/definitions/nodeDataNumber" },
        { "$ref": "#/definitions/nodeDataText" },
        { "$ref": "#/definitions/nodeDataColor" },
        { "$ref": "#/definitions/nodeDataTime" },
        { "$ref": "#/definitions/nodeDataRandom" },
        { "$ref": "#/definitions/nodeDataAudienceInput" }
      ]
    },
    "nodeEventTargetFound": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.targetFound" }
          }
        }
      ]
    },
    "nodeEventTargetLost": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.targetLost" }
          }
        }
      ]
    },
    "nodeEventTap": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.tap" },
            "objectId": {
              "type": "string",
              "description": "터치 이벤트를 받을 오브젝트 ID"
            }
          }
        }
      ]
    },
    "nodeEventButtonClick": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.buttonClick" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeEventTimeElapsed": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "seconds"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.timeElapsed" },
            "seconds": {
              "type": "number",
              "minimum": 0,
              "description": "타깃 인식 후 경과 시간 (초)"
            }
          }
        }
      ]
    },
    "nodeEventVideoEnded": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.videoEnded" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeEventSoundEnded": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "event.soundEnded" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionShow": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.show" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionHide": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.hide" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionToggle": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.toggle" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionPlaySound": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.playSound" },
            "objectId": { "type": "string" },
            "src": { "type": "string" },
            "loop": { "type": "boolean" }
          }
        }
      ]
    },
    "nodeActionPauseSound": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.pauseSound" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionPlayVideo": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.playVideo" },
            "objectId": { "type": "string" },
            "src": { "type": "string" },
            "loop": { "type": "boolean" }
          }
        }
      ]
    },
    "nodeActionPauseVideo": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.pauseVideo" },
            "objectId": { "type": "string" }
          }
        }
      ]
    },
    "nodeActionPlayAnimation": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.playAnimation" },
            "objectId": { "type": "string" },
            "animationName": { "type": "string" },
            "loop": { "type": "boolean" }
          }
        }
      ]
    },
    "nodeActionMoveTo": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId", "position"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.moveTo" },
            "objectId": { "type": "string" },
            "position": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "duration": { "type": "number", "minimum": 0, "description": "이동 시간 (초)" }
          }
        }
      ]
    },
    "nodeActionSetScale": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId", "scale"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.setScale" },
            "objectId": { "type": "string" },
            "scale": {
              "oneOf": [
                { "type": "number" },
                {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 3,
                  "maxItems": 3
                }
              ]
            },
            "duration": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "nodeActionSetColor": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "objectId", "color"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.setColor" },
            "objectId": { "type": "string" },
            "color": { "type": "string", "description": "hex 색상" }
          }
        }
      ]
    },
    "nodeActionOpenURL": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "url"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.openURL" },
            "url": { "type": "string", "format": "uri" },
            "newTab": { "type": "boolean", "default": true }
          }
        }
      ]
    },
    "nodeActionSceneChange": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "sceneId"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "action.sceneChange" },
            "sceneId": { "type": "string" }
          }
        }
      ]
    },
    "nodeDataNumber": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.number" },
            "value": { "type": "number" }
          }
        }
      ]
    },
    "nodeDataText": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.text" },
            "value": { "type": "string" }
          }
        }
      ]
    },
    "nodeDataColor": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.color" },
            "value": { "type": "string", "description": "hex 색상" }
          }
        }
      ]
    },
    "nodeDataTime": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type", "seconds"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.time" },
            "seconds": { "type": "number" }
          }
        }
      ]
    },
    "nodeDataRandom": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.random" },
            "min": { "type": "number", "default": 0 },
            "max": { "type": "number", "default": 1 }
          }
        }
      ]
    },
    "nodeDataAudienceInput": {
      "allOf": [
        { "$ref": "#/definitions/nodeBase" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "const": "data.audienceInput" },
            "prompt": { "type": "string", "description": "관객에게 표시할 입력 안내 문구" },
            "inputType": { "type": "string", "enum": ["text", "number", "choice"], "default": "text" }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "description": "노드 간 실행 연결",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "엣지 ID (선택, 에디터 참조용)"
        },
        "from": {
          "type": "string",
          "description": "출발 노드 ID"
        },
        "to": {
          "type": "string",
          "description": "도착 노드 ID"
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "description": "실행 지연 시간 (초, 선택)"
        }
      }
    }
  }
}
